# Ghostty config — read by cmux (Ghostty-based) and Ghostty itself.
# Dark theme with a light, translucent blurred background.

# Font
font-family = Monaco
font-size = 12

# Built-in dark theme (palette/background/foreground come from here)
theme = Iceberg Dark

# Translucent background with blur (lower opacity = more see-through)
background-opacity = 0.85
background-blur-radius = 20
