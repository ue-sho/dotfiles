# Ghostty config — read by cmux (Ghostty-based) and Ghostty itself.
# Mirrors the look of the previous iTerm2 profile (light theme, Monaco 12),
# with a translucent blurred background added.

# Font (matches the old iTerm2 "Monaco 12" profile)
font-family = Monaco
font-size = 12

# Translucent background with blur
background-opacity = 0.92
background-blur-radius = 20

# Colors ported from the iTerm2 profile (light theme)
background = f9f9f9
foreground = 0f0f0f

cursor-color = 000000
cursor-text = ffffff

selection-background = b3d6ff
selection-foreground = 000000

# ANSI palette (0-15) from the iTerm2 profile
palette = 0=#13181d
palette = 1=#b43c29
palette = 2=#00c100
palette = 3=#c7c400
palette = 4=#2743c7
palette = 5=#bf3fbd
palette = 6=#00c5c7
palette = 7=#c7c7c7
palette = 8=#676767
palette = 9=#dc7974
palette = 10=#57e690
palette = 11=#ece100
palette = 12=#a6aaf1
palette = 13=#e07de0
palette = 14=#5ffdff
palette = 15=#feffff
