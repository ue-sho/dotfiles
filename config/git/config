[init]
    defaultBranch = main
    templateDir = ~/.config/git/template

[core]
	editor = vim
	pager = delta

[delta]
	syntax-theme = Monokai Extended

[commit]
    template = ~/.config/git/commit-template.txt

[include]
    path = conf.d/alias.conf
    path = conf.d/user.conf

[includeIf "gitdir:~/develop/"]
    path = conf.d/local.conf
