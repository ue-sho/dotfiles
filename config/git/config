[init]
    defaultBranch = main
    templateDir = ~/.config/git/template

[core]
	editor = vim
	pager = delta

[delta]
	syntax-theme = Monokai Extended

[commit]
    template = ~/.config/git/commit-template.txt

[include]
    path = conf.d/alias.conf
    path = conf.d/user.conf

[includeIf "gitdir:~/develop/"]
    path = conf.d/local.conf

# git gtr new <branch> で worktree を作ると cmux の 4 ペイン
# ワークスペース (yazi / terminal / difit / claude) が自動で立ち上がる
[gtr "hook"]
    postCreate = cmux-setup

[gtr "copy"]
    include = .envrc
